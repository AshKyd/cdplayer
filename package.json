{
  "name": "cdplayer",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "tauri": "tauri",
    "build:mac": "CI=true tauri build --target universal-apple-darwin",
    "docker:linux-arm64": "docker compose -f docker-compose.build.yml run --rm --build build-linux-arm64",
    "docker:linux-x64": "docker compose -f docker-compose.build.yml run --rm --build build-linux-x64",
    "docker:windows": "docker compose -f docker-compose.build.yml run --rm --build build-windows",
    "build:platforms": "npm run build:mac && npm run docker:linux-arm64 && npm run docker:linux-x64 && npm run docker:windows"
  },
  "license": "ISC",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "bootstrap-icons": "^1.13.2",
    "dexie": "^4.4.7",
    "node-vibrant": "^4.0.4",
    "svelte-akui": "github:ashkyd/svelte-akui"
  },
  "devDependencies": {
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/sveltekit": "^10.6.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "storybook": "^10.6.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
